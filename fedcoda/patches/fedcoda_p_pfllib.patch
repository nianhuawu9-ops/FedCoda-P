+import time
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from flcore.clients.clientrep import clientRep
+
+
+class clientCoda(clientRep):
+    """FedCoda-P client: FedRep-style local head, shared base training."""
+
+    def __init__(self, args, id, train_samples, test_samples, **kwargs):
+        super().__init__(args, id, train_samples, test_samples, **kwargs)
+        self.use_prototypes = bool(getattr(args, "coda_use_prototypes", True))
+        self.proto_weight = float(getattr(args, "coda_proto_weight", 0.1))
+        self.proto_warmup = int(getattr(args, "coda_proto_warmup", 20))
+        self.proto_ramp = int(getattr(args, "coda_proto_ramp", 20))
+        self.align_weight = float(getattr(args, "coda_align_weight", 0.0))
+        self.anchor_tau = float(getattr(args, "coda_anchor_tau", 0.2))
+        self.local_init_alpha = float(getattr(args, "coda_local_init_alpha", 1.0))
+        self.local_init_min_alpha = float(getattr(args, "coda_local_init_min_alpha", 0.5))
+        self.local_init_warmup = int(getattr(args, "coda_local_init_warmup", 0))
+        self.head_init_alpha = float(getattr(args, "coda_head_init_alpha", 0.0))
+        self.head_init_warmup = int(getattr(args, "coda_head_init_warmup", 0))
+        self.current_round = 0
+        self.global_prototypes = {}
+        self.local_prototypes = {}
+        self.V = 0.0
+        self.h = None
+
+    def set_round(self, round_idx):
+        self.current_round = int(round_idx)
+
+    def set_local_init_alpha(self, alpha):
+        self.local_init_alpha = min(1.0, max(self.local_init_min_alpha, float(alpha)))
+
+    def set_parameters(self, model):
+        source = model.base if hasattr(model, "base") else model
+        alpha = 1.0 if self.current_round < self.local_init_warmup else self.local_init_alpha
+        for new_param, old_param in zip(source.parameters(), self.model.base.parameters()):
+            local = old_param.data.clone()
+            old_param.data = alpha * new_param.data.clone() + (1.0 - alpha) * local
+        if hasattr(model, "head") and self.current_round >= self.head_init_warmup and self.head_init_alpha > 0:
+            for new_param, old_param in zip(model.head.parameters(), self.model.head.parameters()):
+                local = old_param.data.clone()
+                old_param.data = self.head_init_alpha * new_param.data.clone() + (1.0 - self.head_init_alpha) * local
+
+    def set_head(self, head, alpha=None):
+        alpha = self.head_init_alpha if alpha is None else float(alpha)
+        for new_param, old_param in zip(head.parameters(), self.model.head.parameters()):
+            local = old_param.data.clone()
+            old_param.data = alpha * new_param.data.clone() + (1.0 - alpha) * local
+
+    def set_prototypes(self, prototypes):
+        self.global_prototypes = {
+            int(label): prototype.detach().to(self.device)
+            for label, prototype in prototypes.items()
+        }
+
+    def _prototype_head_loss(self):
+        if not self.use_prototypes or self.current_round < self.proto_warmup or not self.global_prototypes:
+            return torch.tensor(0.0, device=self.device)
+        labels = sorted(self.global_prototypes)
+        features = torch.stack([self.global_prototypes[label] for label in labels]).to(self.device)
+        targets = torch.tensor(labels, device=self.device, dtype=torch.long)
+        return self.loss(self.model.head(features), targets)
+
+    def _prototype_weight(self, batch_count):
+        if self.current_round < self.proto_warmup:
+            return 0.0
+        ramp = max(1, self.proto_ramp)
+        progress = min(1.0, (self.current_round - self.proto_warmup + 1) / ramp)
+        # ponytail: same prototype set is reused every batch; normalize so epoch-level weight stays stable.
+        return self.proto_weight * progress / max(1, batch_count)
+
+    def _alignment_loss(self, features, labels):
+        if not self.use_prototypes or self.current_round < self.proto_warmup or self.align_weight <= 0 or not self.global_prototypes:
+            return torch.tensor(0.0, device=self.device)
+        anchor_labels = sorted(self.global_prototypes)
+        label_to_index = {label: index for index, label in enumerate(anchor_labels)}
+        keep = torch.tensor([int(label.item()) in label_to_index for label in labels], device=self.device)
+        if not bool(keep.any()):
+            return torch.tensor(0.0, device=self.device)
+        anchors = torch.stack([self.global_prototypes[label] for label in anchor_labels]).to(self.device)
+        logits = F.normalize(features[keep].float(), dim=1).mm(F.normalize(anchors.float(), dim=1).t())
+        logits = logits / max(self.anchor_tau, 1e-6)
+        targets = torch.tensor([label_to_index[int(label.item())] for label in labels[keep]], device=self.device)
+        return self.loss(logits, targets)
+
+    def collect_prototypes(self):
+        trainloader = self.load_train_data()
+        sums = {}
+        counts = {}
+        sq_sums = {}
+        total_count = 0
+        feature_dim = None
+        self.model.eval()
+        with torch.no_grad():
+            for x, y in trainloader:
+                if type(x) == type([]):
+                    x[0] = x[0].to(self.device)
+                else:
+                    x = x.to(self.device)
+                y = y.to(self.device)
+                features = self.model.base(x)
+                if feature_dim is None:
+                    feature_dim = features.shape[1]
+                total_count += int(y.shape[0])
+                for label in y.unique():
+                    label_int = int(label.item())
+                    class_features = features[y == label]
+                    batch_sum = class_features.sum(dim=0).detach().cpu()
+                    batch_count = int((y == label).sum().item())
+                    sums[label_int] = sums.get(label_int, torch.zeros_like(batch_sum)) + batch_sum
+                    sq_sums[label_int] = sq_sums.get(label_int, 0.0) + float(class_features.detach().float().pow(2).sum().cpu().item())
+                    counts[label_int] = counts.get(label_int, 0) + batch_count
+        self.local_prototypes = {
+            label: (sums[label] / counts[label], counts[label])
+            for label in sums
+            if counts[label] > 0
+        }
+        self.h = torch.zeros((self.num_classes, feature_dim), device=self.device) if feature_dim is not None else None
+        variance = 0.0
+        if self.h is not None and total_count > 0:
+            for label, count in counts.items():
+                mean = (sums[label] / count).to(self.device)
+                py = count / total_count
+                self.h[label] = py * mean
+                variance += py * (sq_sums[label] / count) - (py * py) * float(mean.pow(2).sum().detach().cpu().item())
+        self.V = variance / max(1, self.train_samples)
+
+    def train(self):
+        trainloader = self.load_train_data()
+        batch_count = len(trainloader)
+        start_time = time.time()
+        self.model.train()
+
+        for param in self.model.base.parameters():
+            param.requires_grad = False
+        for param in self.model.head.parameters():
+            param.requires_grad = True
+
+        for _ in range(self.plocal_epochs):
+            for x, y in trainloader:
+                if type(x) == type([]):
+                    x[0] = x[0].to(self.device)
+                else:
+                    x = x.to(self.device)
+                y = y.to(self.device)
+                if self.train_slow:
+                    time.sleep(0.1 * np.abs(np.random.rand()))
+                output = self.model(x)
+                loss = self.loss(output, y) + self._prototype_weight(batch_count) * self._prototype_head_loss()
+                self.optimizer_per.zero_grad()
+                loss.backward()
+                self.optimizer_per.step()
+
+        max_local_epochs = self.local_epochs
+        if self.train_slow:
+            max_local_epochs = np.random.randint(1, max_local_epochs // 2)
+
+        for param in self.model.base.parameters():
+            param.requires_grad = True
+        for param in self.model.head.parameters():
+            param.requires_grad = False
+
+        for _ in range(max_local_epochs):
+            for x, y in trainloader:
+                if type(x) == type([]):
+                    x[0] = x[0].to(self.device)
+                else:
+                    x = x.to(self.device)
+                y = y.to(self.device)
+                if self.train_slow:
+                    time.sleep(0.1 * np.abs(np.random.rand()))
+                features = self.model.base(x)
+                output = self.model.head(features)
+                loss = self.loss(output, y) + self.align_weight * self._alignment_loss(features, y)
+                self.optimizer.zero_grad()
+                loss.backward()
+                self.optimizer.step()
+
+        self.collect_prototypes()
+
+        if self.learning_rate_decay:
+            self.learning_rate_scheduler.step()
+            self.learning_rate_scheduler_per.step()
+
+        self.train_time_cost['num_rounds'] += 1
+        self.train_time_cost['total_cost'] += time.time() - start_time
