+import copy
+import random
+import time
+
+import numpy as np
+import torch
+
+try:
+    from flcore.servers.serverbase import Server
+except ModuleNotFoundError:
+    Server = object
+
+
+def _cosine_conflict(delta, reference):
+    delta = delta.reshape(-1).float()
+    reference = reference.reshape(-1).float()
+    denom = torch.linalg.vector_norm(delta) * torch.linalg.vector_norm(reference)
+    if denom.item() <= 1e-12:
+        return 0.0
+    cosine = torch.dot(delta, reference) / denom.clamp_min(1e-12)
+    return float((1.0 - torch.clamp(cosine, -1.0, 1.0).item()) * 0.5)
+
+
+def _average_prototypes(client_prototypes):
+    totals = {}
+    counts = {}
+    for prototypes in client_prototypes:
+        for label, value in prototypes.items():
+            prototype, count = value
+            label = int(label)
+            if count <= 0:
+                continue
+            if label not in totals:
+                totals[label] = prototype.detach().cpu().float() * count
+                counts[label] = count
+            else:
+                totals[label] += prototype.detach().cpu().float() * count
+                counts[label] += count
+    return {label: totals[label] / counts[label] for label in totals}
+
+
+def _ema_prototypes(previous, current, momentum):
+    updated = dict(previous)
+    for label, prototype in current.items():
+        if label in updated:
+            updated[label] = momentum * updated[label].detach().cpu().float() + (1.0 - momentum) * prototype.detach().cpu().float()
+        else:
+            updated[label] = prototype.detach().cpu().float()
+    return updated
+
+
+def _select_shareable_clients(clients, scores, join_count, random_ratio, rng):
+    join_count = min(join_count, len(clients))
+    random_count = min(join_count, max(0, int(round(join_count * random_ratio))))
+    top_count = join_count - random_count
+    ranked = sorted(clients, key=lambda client: scores.get(client.id, 0.0), reverse=True)
+    selected = ranked[:top_count]
+    remaining = [client for client in clients if client not in selected]
+    if random_count > 0 and remaining:
+        selected.extend(rng.sample(remaining, min(random_count, len(remaining))))
+    return selected
+
+
+def _client_consensus_conflicts(global_model, uploaded_weights, uploaded_models):
+    if not uploaded_models:
+        return []
+    global_params = dict(global_model.base.named_parameters())
+    consensuses = {}
+    for name, global_param in global_params.items():
+        consensuses[name] = sum(
+            weight * (dict(model.base.named_parameters())[name].data - global_param.data)
+            for weight, model in zip(uploaded_weights, uploaded_models)
+        )
+    conflicts = []
+    for model in uploaded_models:
+        model_params = dict(model.base.named_parameters())
+        layer_conflicts = [
+            _cosine_conflict(model_params[name].data - global_param.data, consensuses[name])
+            for name, global_param in global_params.items()
+        ]
+        conflicts.append(float(np.mean(layer_conflicts)) if layer_conflicts else 0.0)
+    return conflicts
+
+
+def _aggregate_head(global_model, uploaded_weights, uploaded_models):
+    if not uploaded_models or not hasattr(global_model, "head"):
+        return
+    with torch.no_grad():
+        for name, global_param in global_model.head.named_parameters():
+            client_params = [dict(model.head.named_parameters())[name].data for model in uploaded_models]
+            global_param.data = sum(weight * param for weight, param in zip(uploaded_weights, client_params)).clone()
+
+
+def _weighted_head_sum(heads, weights):
+    new_head = copy.deepcopy(heads[0])
+    with torch.no_grad():
+        for param in new_head.parameters():
+            param.data.zero_()
+        for weight, head in zip(weights, heads):
+            for new_param, head_param in zip(new_head.parameters(), head.parameters()):
+                new_param.data.add_(head_param.data, alpha=float(weight))
+    return new_head
+
+
+def _solve_pac_weights(num_users, variances, means):
+    try:
+        from flcore.servers.serverpac import solve_quadratic
+        return solve_quadratic(num_users, variances, means)
+    except Exception:
+        # ponytail: cvxpy can be absent or fail numerically; uniform weights keep the round usable.
+        return [[1.0 / num_users] * num_users for _ in range(num_users)]
+
+
+class FedCodaAggregator:
+    def __init__(self, args, model):
+        if not hasattr(model, "base"):
+            raise ValueError("FedCoda-P requires a BaseHeadSplit model with a .base module.")
+        self.spatial_strength = float(getattr(args, "coda_spatial_strength", 0.7))
+        self.temporal_strength = float(getattr(args, "coda_temporal_strength", 0.3))
+        self.min_eligibility = float(getattr(args, "coda_min_eligibility", 0.05))
+        self.temporal_ema = float(getattr(args, "coda_temporal_ema", 0.8))
+        self.spatial_pairs = int(getattr(args, "coda_spatial_pairs", 128))
+        self.rng = random.Random(int(getattr(args, "coda_pair_seed", 0)))
+        self.conflict_gate = float(getattr(args, "coda_conflict_gate", 0.6))
+        self.project_updates = bool(getattr(args, "coda_projection", True))
+        self.adaptive_gate = bool(getattr(args, "coda_adaptive_gate", True))
+        self.layer_freeze = bool(getattr(args, "coda_layer_freeze", False))
+        self.freeze_spatial = float(getattr(args, "coda_freeze_spatial", 0.48))
+        self.freeze_temporal = float(getattr(args, "coda_freeze_temporal", 0.2))
+        self.freeze_patience = int(getattr(args, "coda_freeze_patience", 2))
+        self.freeze_counts = {}
+        self.gate_step = float(getattr(args, "coda_gate_step", 0.05))
+        self.gate_min = float(getattr(args, "coda_gate_min", 0.4))
+        self.gate_max = float(getattr(args, "coda_gate_max", 0.8))
+        self.last_accuracy = None
+        self.gate_keywords = [
+            item.strip()
+            for item in str(getattr(args, "coda_gate_keywords", "fc1")).split(",")
+            if item.strip()
+        ]
+        self.previous_delta = {
+            name: torch.zeros_like(param.data.detach())
+            for name, param in model.base.named_parameters()
+        }
+
+    def _sample_pairs(self, count):
+        pairs = [(i, j) for i in range(count) for j in range(i + 1, count)]
+        if self.spatial_pairs > 0 and len(pairs) > self.spatial_pairs:
+            return self.rng.sample(pairs, self.spatial_pairs)
+        return pairs
+
+    def _should_gate(self, name, spatial):
+        return spatial > self.conflict_gate and any(keyword in name for keyword in self.gate_keywords)
+
+    def _should_freeze(self, name, spatial, temporal):
+        if not self.layer_freeze:
+            return False
+        if spatial > self.freeze_spatial or temporal > self.freeze_temporal:
+            self.freeze_counts[name] = self.freeze_counts.get(name, 0) + 1
+        else:
+            self.freeze_counts[name] = 0
+        return self.freeze_counts[name] >= max(1, self.freeze_patience)
+
+    def _project_conflict_free(self, aggregate, reference):
+        denom = torch.dot(reference.reshape(-1).float(), reference.reshape(-1).float())
+        if denom.item() <= 1e-12:
+            return aggregate, False
+        scale = torch.dot(aggregate.reshape(-1).float(), reference.reshape(-1).float()) / denom
+        if scale.item() >= 0:
+            return aggregate, False
+        return aggregate - scale.to(aggregate.dtype) * reference, True
+
+    def update_accuracy(self, accuracy):
+        if not self.adaptive_gate:
+            return
+        if self.last_accuracy is not None:
+            step = self.gate_step if accuracy >= self.last_accuracy else -self.gate_step
+            self.conflict_gate = min(self.gate_max, max(self.gate_min, self.conflict_gate + step))
+        self.last_accuracy = accuracy
+
+    def aggregate(self, global_model, uploaded_weights, uploaded_models):
+        diagnostics = []
+        spatial_pair_count = 0
+        gated_tensors = 0
+        frozen_tensors = 0
+        projected_tensors = 0
+        with torch.no_grad():
+            for name, global_param in global_model.base.named_parameters():
+                client_params = [
+                    dict(model.base.named_parameters())[name].data
+                    for model in uploaded_models
+                ]
+                aggregate = sum(
+                    weight * (client_param - global_param.data)
+                    for weight, client_param in zip(uploaded_weights, client_params)
+                )
+                deltas = [client_param - global_param.data for client_param in client_params]
+                pairs = self._sample_pairs(len(deltas))
+                spatial_pair_count += len(pairs)
+                pairwise = [
+                    _cosine_conflict(deltas[left], deltas[right])
+                    for left, right in pairs
+                ]
+                spatial = float(np.mean(pairwise)) if pairwise else 0.0
+                consensus = sum(deltas) / len(deltas)
+                if self.project_updates:
+                    aggregate, projected = self._project_conflict_free(aggregate, consensus)
+                    projected_tensors += int(projected)
+                temporal = _cosine_conflict(
+                    aggregate, self.previous_delta.get(name, torch.zeros_like(aggregate))
+                )
+                if self._should_freeze(name, spatial, temporal):
+                    eligibility = 0.0
+                    frozen_tensors += 1
+                elif self._should_gate(name, spatial):
+                    eligibility = 0.0
+                    gated_tensors += 1
+                else:
+                    eligibility = max(
+                        self.min_eligibility,
+                        min(1.0, 1.0 - self.spatial_strength * spatial - self.temporal_strength * temporal),
+                    )
+                # ponytail: tensor-level eligibility; semantic blocks only if reviewers demand coarser structure.
+                global_param.data.add_(eligibility * aggregate)
+                self.previous_delta[name].mul_(self.temporal_ema).add_(
+                    aggregate.detach(),
+                    alpha=1.0 - self.temporal_ema,
+                )
+                diagnostics.append((spatial, temporal, eligibility))
+
+        return {
+            "mean_spatial_conflict": float(np.mean([d[0] for d in diagnostics])) if diagnostics else 0.0,
+            "mean_temporal_conflict": float(np.mean([d[1] for d in diagnostics])) if diagnostics else 0.0,
+            "mean_eligibility": float(np.mean([d[2] for d in diagnostics])) if diagnostics else 1.0,
+            "spatial_pairs": int(spatial_pair_count),
+            "gated_tensors": int(gated_tensors),
+            "frozen_tensors": int(frozen_tensors),
+            "projected_tensors": int(projected_tensors),
+            "conflict_gate": float(self.conflict_gate),
+        }
+
+
+class FedCoda(Server):
+    def __init__(self, args, times):
+        super().__init__(args, times)
+        from flcore.clients.clientcoda import clientCoda
+
+        self.set_slow_clients()
+        self.set_clients(clientCoda)
+        self.client_by_id = {client.id: client for client in self.clients}
+        self.aggregator = FedCodaAggregator(args, self.global_model)
+        self.global_prototypes = {}
+        self.anchor_ema = float(getattr(args, "coda_anchor_ema", 0.9))
+        self.client_select = bool(getattr(args, "coda_client_select", False))
+        self.select_warmup = int(getattr(args, "coda_select_warmup", 20))
+        self.select_random_ratio = float(getattr(args, "coda_select_random_ratio", 0.5))
+        self.select_conflict_weight = float(getattr(args, "coda_select_conflict_weight", 1.0))
+        self.select_coverage_weight = float(getattr(args, "coda_select_coverage_weight", 0.05))
+        self.local_init_alpha = float(getattr(args, "coda_local_init_alpha", 1.0))
+        self.local_init_min_alpha = float(getattr(args, "coda_local_init_min_alpha", 0.5))
+        self.local_init_warmup = int(getattr(args, "coda_local_init_warmup", 0))
+        self.head_collab = bool(getattr(args, "coda_head_collab", False))
+        self.pac_head_collab = bool(getattr(args, "coda_pac_head_collab", False))
+        self.pac_head_alpha = float(getattr(args, "coda_pac_head_alpha", 0.2))
+        self.pac_head_warmup = int(getattr(args, "coda_pac_head_warmup", 30))
+        self.client_scores = {}
+        self.client_conflicts = {}
+        self.current_round = 0
+        self.conflict_history = []
+        self.Budget = []
+
+        print(f"\nJoin ratio / total clients: {self.join_ratio} / {self.num_clients}")
+        print("Finished creating server and clients.")
+
+    def select_clients(self):
+        if self.random_join_ratio:
+            self.current_num_join_clients = np.random.choice(range(self.num_join_clients, self.num_clients + 1), 1, replace=False)[0]
+        else:
+            self.current_num_join_clients = self.num_join_clients
+        if not self.client_select or self.current_round < self.select_warmup:
+            return list(np.random.choice(self.clients, self.current_num_join_clients, replace=False))
+        return _select_shareable_clients(
+            self.clients,
+            self.client_scores,
+            self.current_num_join_clients,
+            self.select_random_ratio,
+            random,
+        )
+
+    def send_models(self):
+        for client in self.clients:
+            client.set_round(self.current_round)
+            conflict = self.client_conflicts.get(client.id, 0.0)
+            alpha = self.local_init_alpha if self.current_round < self.local_init_warmup else self.local_init_alpha - conflict
+            client.set_local_init_alpha(max(self.local_init_min_alpha, alpha))
+            client.set_prototypes(self.global_prototypes)
+        super().send_models()
+
+    def receive_models(self):
+        assert (len(self.selected_clients) > 0)
+
+        active_clients = random.sample(
+            self.selected_clients, int((1-self.client_drop_rate) * self.current_num_join_clients))
+
+        self.uploaded_ids = []
+        self.uploaded_weights = []
+        self.uploaded_models = []
+        self.uploaded_heads = []
+        self.uploaded_prototypes = []
+        self.uploaded_vars = []
+        self.uploaded_hs = []
+        tot_samples = 0
+        for client in active_clients:
+            try:
+                client_time_cost = client.train_time_cost['total_cost'] / client.train_time_cost['num_rounds'] + \
+                        client.send_time_cost['total_cost'] / client.send_time_cost['num_rounds']
+            except ZeroDivisionError:
+                client_time_cost = 0
+            if client_time_cost <= self.time_threthold:
+                tot_samples += client.train_samples
+                self.uploaded_ids.append(client.id)
+                self.uploaded_weights.append(client.train_samples)
+                self.uploaded_models.append(client.model)
+                self.uploaded_heads.append(client.model.head)
+                self.uploaded_prototypes.append(client.local_prototypes)
+                self.uploaded_vars.append(float(getattr(client, "V", 0.0)))
+                self.uploaded_hs.append(getattr(client, "h", None))
+        for i, w in enumerate(self.uploaded_weights):
+            self.uploaded_weights[i] = w / tot_samples
+
+    def aggregate_parameters(self):
+        self.update_client_scores()
+        self.last_diagnostics = self.aggregator.aggregate(
+            self.global_model,
+            self.uploaded_weights,
+            self.uploaded_models,
+        )
+        if self.head_collab:
+            _aggregate_head(self.global_model, self.uploaded_weights, self.uploaded_models)
+        if self.pac_head_collab and self.current_round >= self.pac_head_warmup:
+            self.aggregate_and_send_pac_heads()
+
+    def aggregate_and_send_pac_heads(self):
+        if not self.uploaded_heads or any(h is None for h in self.uploaded_hs):
+            return
+        weights = _solve_pac_weights(len(self.uploaded_heads), self.uploaded_vars, self.uploaded_hs)
+        sent = 0
+        for index, client_id in enumerate(self.uploaded_ids):
+            if weights[index] is None:
+                continue
+            head = _weighted_head_sum(self.uploaded_heads, weights[index])
+            self.client_by_id[client_id].set_head(head, self.pac_head_alpha)
+            sent += 1
+        if hasattr(self, "last_diagnostics"):
+            self.last_diagnostics["pac_heads"] = int(sent)
+
+    def update_client_scores(self):
+        if not self.client_select or not self.uploaded_models:
+            return
+        with torch.no_grad():
+            conflicts = _client_consensus_conflicts(self.global_model, self.uploaded_weights, self.uploaded_models)
+            for client_id, conflict in zip(self.uploaded_ids, conflicts):
+                coverage = len(getattr(self.client_by_id.get(client_id), "local_prototypes", {}))
+                self.client_conflicts[client_id] = conflict
+                self.client_scores[client_id] = self.select_coverage_weight * coverage - self.select_conflict_weight * conflict
+
+    def aggregate_prototypes(self):
+        current = _average_prototypes(self.uploaded_prototypes)
+        self.global_prototypes = _ema_prototypes(self.global_prototypes, current, self.anchor_ema)
+
+    def train(self):
+        for i in range(self.global_rounds + 1):
+            self.current_round = i
+            s_t = time.time()
+            self.selected_clients = self.select_clients()
+            self.send_models()
+
+            if i % self.eval_gap == 0:
+                print(f"\n-------------Round number: {i}-------------")
+                print("\nEvaluate personalized models")
+                self.evaluate()
+                self.aggregator.update_accuracy(self.rs_test_acc[-1])
+
+            for client in self.selected_clients:
+                client.train()
+
+            self.receive_models()
+            if self.dlg_eval and i % self.dlg_gap == 0:
+                self.call_dlg(i)
+            self.aggregate_parameters()
+            self.aggregate_prototypes()
+            self.conflict_history.append({"round": i, **self.last_diagnostics})
+
+            self.Budget.append(time.time() - s_t)
+            print(
+                "-" * 25,
+                "time cost",
+                "-" * 25,
+                self.Budget[-1],
+                "Coda",
+                self.last_diagnostics,
+            )
+
+            if self.auto_break and self.check_done(acc_lss=[self.rs_test_acc], top_cnt=self.top_cnt):
+                break
+
+        print("\nBest accuracy.")
+        print(max(self.rs_test_acc))
+        print("\nAverage time cost per round.")
+        print(sum(self.Budget[1:]) / len(self.Budget[1:]))
+        self.save_results()
